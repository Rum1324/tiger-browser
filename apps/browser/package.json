{
  "name": "@tiger/browser",
  "version": "0.1.0",
  "private": true,
  "description": "Tiger browser engine (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && xvfb-run -a --server-args='-screen 0 1600x1000x24' vitest run -c vitest.e2e.config.ts",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "test:package": "electron-vite build && electron-builder --dir && xvfb-run -a node test/package/smoke.mts",
    "rig": "vite --config rig.vite.config.ts --open /rig.html?screen=app/page-fresh",
    "rig:shots": "tsx test/rig/shots.mts",
    "rig:compare": "tsx test/rig/compare.mts",
    "test:rig": "vitest run -c vitest.rig.config.ts",
    "tokens:sync": "node -e \"require('node:fs').copyFileSync('../../design/final/tokens.css','src/renderer/src/theme/tokens.css')\""
  },
  "devDependencies": {
    "@tiger/client": "workspace:*",
    "@tiger/extract": "workspace:*",
    "@tiger/server": "workspace:*",
    "@tiger/shared": "workspace:*",
    "@types/node": "^22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "marked": "18.2.0",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.2",
    "x11": "4.4.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "author": "Tiger"
}
