{
  "name": "@tiger/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/websocket": "^11.3.7",
    "@huggingface/transformers": "4.3.2",
    "@tiger/llm": "workspace:*",
    "@tiger/shared": "workspace:*",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  }
}
