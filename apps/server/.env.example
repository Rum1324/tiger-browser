# Copy to .env for `pnpm dev`. Never commit a filled-in .env.
NODE_ENV=development
DATABASE_URL=postgres://tiger:tiger@127.0.0.1:5432/tiger_dev
HOST=127.0.0.1
PORT=8787
# Base URL clients reach this server on; invite links are built from it.
PUBLIC_URL=http://localhost:8787
# Comma-separated browser origins allowed by CORS: the packaged UI and the Vite dev server.
CORS_ORIGINS=tiger://ui,http://localhost:5173
# 1 enables POST /v1/auth/dev (sign in with any email, no password). Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=1
# OAuth client id the Google ID tokens must be issued for. Leave empty to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
SESSION_TTL_DAYS=30
# Monthly token budget (input + output) given to each new Space. Empty = unlimited.
SPACE_TOKEN_BUDGET=
# Requests per minute per IP on the unauthenticated routes and invite acceptance.
AUTH_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=info
# Provider keys for the chat agent. Read only on the server; never sent to clients.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Retrieval ──
# Embedding model: e5 (multilingual-e5-small q8, downloaded on first use) or hash (deterministic, tests only).
RETRIEVAL_EMBEDDER=e5
# Where the e5 model files are cached. Empty = ~/.cache/tiger/models.
RETRIEVAL_MODEL_CACHE_DIR=
# A Space whose shared items fit in this many estimated tokens is sent whole (cached) instead of retrieved.
RETRIEVAL_WHOLE_SPACE_MAX_TOKENS=40000
# Weight of the pg_trgm keyword leg in rank fusion; 0 turns it off.
RETRIEVAL_KEYWORD_WEIGHT=0.5

# ── Chat ──
# provider/model-id used when the client names no model. Empty or unusable = the best model of whichever
# provider has a key (anthropic/claude-sonnet-5-5 first), else the offline mock.
CHAT_DEFAULT_MODEL=
# provider/model-id that writes thread titles. Empty = the cheapest available model.
CHAT_TITLE_MODEL=
# 1 = always offer the offline mock model, 0 = never. Empty = offered only when no provider key is set
# and NODE_ENV is not production.
CHAT_ENABLE_MOCK=
# 0 turns generated thread titles off.
CHAT_THREAD_TITLES=1
